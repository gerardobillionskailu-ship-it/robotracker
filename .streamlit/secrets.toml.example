# TradeOlympo - Configuración de Secrets
#
# IMPORTANTE: Este archivo es solo un EJEMPLO.
#
# Para configurar tu aplicación:
#
# 1. En Streamlit Cloud:
#    - Ve a tu dashboard: https://share.streamlit.io
#    - Selecciona tu app "robotracker"
#    - Click en Settings → Secrets
#    - Copia y pega el contenido de abajo (sin los comentarios #)
#    - Reemplaza "TU_API_KEY_AQUI" con tu clave real
#
# 2. Para desarrollo local:
#    - Crea un archivo llamado "secrets.toml" (sin .example)
#    - Copia el contenido de abajo
#    - NUNCA hagas commit de secrets.toml (ya está en .gitignore)

# Alpha Vantage API Key
# Obtén tu clave GRATIS en: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY = "TU_API_KEY_AQUI"
